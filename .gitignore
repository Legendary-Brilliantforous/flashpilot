# Rust
/target/
/build/target/

# Python virtualenv
.venv/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/

# Build / cache / runtime artifacts (all under build/ now)
/build/
!/build/.gitkeep
!/build/README.md

# Legacy runtime data — kept outside build/ because scripts write here
/efs_backups/
/odin4.log

# Local device artifacts (matched anywhere in the tree)
*.pit
*.bin
*.tar
*.tar.md5
*.img
*.lz4
*.zst
*.zstd
/build/mdm_qr/*.png
/build/mdm_qr/*.json

# Proprietary tools fetched at setup time (see scripts/fetch-odin4.sh)
/root/tools/odin4

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
